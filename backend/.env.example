# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fenix26

# Client
CLIENT_URL=http://localhost:5173

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Brevo transactional email (HTTPS API; works on Render)
# Generate an API key in Brevo. Never expose this value to the frontend.
BREVO_API_KEY=xkeysib-your-brevo-api-key
# This sender must be verified in Brevo before email can be sent.
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
BREVO_SENDER_NAME=FENIX'26

# Cloudinary - screenshot storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# UPI Payment
UPI_ID=your-upi-id
UPI_NAME=Your Name

# JWT
JWT_SECRET=change-this-secret

# Workshop Rules
WORKSHOP_RULES="1. Complete registration with valid details. 2. Payment must be verified. 3. Bring your registration ID. 4. Report 15 minutes before the workshop. 5. Follow the instructions of the organizers."
